# Copy this file to .env.local and fill in the values below.
#
# For local development against `npx hardhat node` (see contracts/README.md),
# use:
#   RPC_URL=http://127.0.0.1:8545
#   CONTRACT_ADDRESS=<address printed by the deploy script>
#   PRIVATE_KEY=<any private key printed by `npx hardhat node` — they're
#                 well-known test keys, safe to use locally>
#   ADMIN_PASSPHRASE=pick-anything

RPC_URL=
CONTRACT_ADDRESS=
PRIVATE_KEY=
ADMIN_PASSPHRASE=
